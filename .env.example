# ==========================================
# DevTrack AI — Production Environment Variables
# ==========================================

# 1. PostgreSQL Database Connection URL (e.g. Neon, Supabase, Railway, AWS RDS, local)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=prefer
DATABASE_URL="postgresql://postgres:password@localhost:5432/devtrack_ai?schema=public"

# 2. NextAuth Configuration & Secret
# Generate a strong 32+ character random secret using: openssl rand -base64 32
NEXTAUTH_SECRET="devtrack-super-secret-key-change-in-production-min-32-chars"

# 3. Canonical App URL (Required for NextAuth in production)
# In local development: http://localhost:3000
# In production on Vercel: https://your-devtrack-domain.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# 4. Optional AI Integration Key (OpenAI / DeepSeek / Gemini)
# Used for natural language parsing and intelligent recommendations
OPENAI_API_KEY=""

# 5. Node Environment
NODE_ENV="development"

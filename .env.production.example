# ==========================================
# DevTrack AI Production Environment Template
# ==========================================

# 1. Database Connection (PostgreSQL)
# For Vercel: Use Neon (neon.tech) or Supabase (supabase.com) free Postgres connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/devtrack_ai?sslmode=require"

# 2. NextAuth Configuration
# Your deployed domain URL (e.g. https://devtrack-ai.vercel.app)
NEXTAUTH_URL="https://your-deployed-app.vercel.app"

# Generate a 32+ character random string: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-secure-random-32-char-key-here"

# 3. Google Gemini AI API (Optional, for AI Mentor chat & quick parse)
GEMINI_API_KEY="your-gemini-api-key-here"
